{
  "id": "journal",
  "name": "Journal",
  "version": "1.3.0",
  "engine": "quickieweb-template@1",
  "description": "An editorial layout: serif headlines, a card index, and a provenance card for posts that respond to something else.",
  "author": "Quickieweb",
  "license": "MIT",
  "supports": [
    "article",
    "podcast",
    "page"
  ],
  "layouts": {
    "index": "layouts/index.html",
    "article": "layouts/article.html",
    "page": "layouts/page.html",
    "404": "layouts/404.html"
  },
  "partials": {
    "head": "partials/head.html",
    "masthead": "partials/masthead.html",
    "footer": "partials/footer.html",
    "card": {
      "path": "partials/card.html",
      "context": "post"
    }
  },
  "styles": [
    "assets/style.css"
  ],
  "tokens": {
    "color.ink": {
      "type": "color",
      "default": "#14161a",
      "label": "Body text",
      "group": "Color"
    },
    "color.ink_soft": {
      "type": "color",
      "default": "#4a5058",
      "label": "Secondary text",
      "group": "Color"
    },
    "color.ink_faint": {
      "type": "color",
      "default": "#767d87",
      "label": "Faint text",
      "group": "Color"
    },
    "color.paper": {
      "type": "color",
      "default": "#f7f6f3",
      "label": "Page background",
      "group": "Color"
    },
    "color.card": {
      "type": "color",
      "default": "#ffffff",
      "label": "Card background",
      "group": "Color"
    },
    "color.rule": {
      "type": "color",
      "default": "#ddd9d1",
      "label": "Rules and borders",
      "group": "Color"
    },
    "color.accent": {
      "type": "color",
      "default": "#b3341f",
      "label": "Accent",
      "group": "Color"
    },
    "color.accent2": {
      "type": "color",
      "default": "#1b6b57",
      "label": "Second accent",
      "group": "Color"
    },
    "dark.color.ink": {
      "type": "color",
      "default": "#e9e6e0",
      "label": "Body text",
      "group": "Color (dark mode)"
    },
    "dark.color.ink_soft": {
      "type": "color",
      "default": "#a8a49c",
      "label": "Secondary text",
      "group": "Color (dark mode)"
    },
    "dark.color.ink_faint": {
      "type": "color",
      "default": "#7d7973",
      "label": "Faint text",
      "group": "Color (dark mode)"
    },
    "dark.color.paper": {
      "type": "color",
      "default": "#14151a",
      "label": "Page background",
      "group": "Color (dark mode)"
    },
    "dark.color.card": {
      "type": "color",
      "default": "#1c1e24",
      "label": "Card background",
      "group": "Color (dark mode)"
    },
    "dark.color.rule": {
      "type": "color",
      "default": "#2f323a",
      "label": "Rules and borders",
      "group": "Color (dark mode)"
    },
    "dark.color.accent": {
      "type": "color",
      "default": "#ef6a4f",
      "label": "Accent",
      "group": "Color (dark mode)"
    },
    "dark.color.accent2": {
      "type": "color",
      "default": "#4fbf9c",
      "label": "Second accent",
      "group": "Color (dark mode)"
    },
    "font.body": {
      "type": "font",
      "default": "-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif",
      "label": "Body font",
      "group": "Type"
    },
    "font.display": {
      "type": "font",
      "default": "Iowan Old Style, Palatino Linotype, Palatino, Georgia, Times New Roman, serif",
      "label": "Headline font",
      "group": "Type"
    },
    "font.mono": {
      "type": "font",
      "default": "ui-monospace, SF Mono, Cascadia Mono, Menlo, Consolas, monospace",
      "label": "Monospace font",
      "group": "Type"
    },
    "layout.measure": {
      "type": "select",
      "default": "34rem",
      "label": "Text column width",
      "group": "Layout",
      "options": [
        {
          "value": "30rem",
          "label": "Narrow"
        },
        {
          "value": "34rem",
          "label": "Standard"
        },
        {
          "value": "40rem",
          "label": "Wide"
        }
      ]
    },
    "logo": {
      "type": "image",
      "optional": true,
      "label": "Masthead logo",
      "group": "Branding",
      "help": "Replaces the site name in the masthead. PNG, SVG or WebP; about 40px tall."
    },
    "show_tagline": {
      "type": "boolean",
      "default": true,
      "label": "Show the tagline",
      "group": "Branding"
    },
    "footer_note": {
      "type": "text",
      "default": "",
      "label": "Footer note",
      "group": "Branding",
      "help": "A line under the credit. Leave empty to omit it."
    }
  }
}
